{
  "name": "dime-game",
  "author": "Jordan Hitch",
  "version": "0.1.0",
  "homepage": "/",
  "private": true,
  "description": "Simple web app for the DBT \"Dime Game\" used to determine how strongly you should push when making a request or giving a \"no\" answer in an interaction",
  "devDependencies": {
    "gh-pages": ">=0.12.0",
    "react-scripts": "^5.0.1"
  },
  "dependencies": {
    "bootstrap": ">=5.3.8",
    "react": ">=19.1.1",
    "react-bootstrap": ">=2.10.10",
    "react-document-meta": ">=2.1.2",
    "react-dom": ">=19.1.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "keywords": [
    "dbt",
    "dime game",
    "interpersonal effectiveness",
    "when to say no",
    "when to ask"
  ],
  "license": "ISC",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
